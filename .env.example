# Data Steward Claw —— 本地配置
# 本文件已 gitignore。结构见 .env.example

# ---------------- 模型端点（阿里云百炼 / DashScope，OpenAI 兼容） ----------------
OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-<your-dashscope-key>
OPENAI_MODEL=qwen3.7-plus
# 只用免费额度内的模型
DASHSCOPE_FREE_ONLY=true
# 免费额度按模型独立计算，耗尽后按序降级
OPENAI_MODEL_FALLBACKS=qwen3.7-plus-2026-05-26,kimi-k2.7-code,qwen3.7-flash-2026-07-15
DASHSCOPE_FREE_MODELS=qwen3.7-max-2026-05-20,qwen3.7-max,qwen3.7-max-preview,glm-5.1,qwen3.7-plus,qwen3.7-plus-2026-05-26,glm-5.2,kimi-k2.7-code,qwen3.7-flash-2026-07-15,deepseek-v4-flash-0731

# ---------------- 审批服务 ----------------
DATASTEWARD_TOKEN_SECRET=<run: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'>
APPROVAL_PORT=8787
# 「先模拟」：链接指向本机，审批人在本机点击
APPROVAL_BASE_URL=http://127.0.0.1:8787

# ---------------- 存储 ----------------
DATASTEWARD_DB=$HOME/.datalaker/approvals.db
STEWARD_AGENT_DSN=postgresql://agent_role:agent_pass@127.0.0.1:5432/steward
STEWARD_APPROVER_DSN=postgresql://approver_role:approver_pass@127.0.0.1:5432/steward
SOURCE_DSN=postgresql://agent_ro:ro_pass@127.0.0.1:5432/olist
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password

# ---------------- 邮件 ----------------
# smtp = 应用专用密码（推荐：零依赖，不需要 Google 应用验证）
# gmail_api = OAuth（需在 Cloud Console 把自己加进 Test users）
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com

# ---------------- Gmail OAuth（仅 MAIL_TRANSPORT=gmail_api 时需要） ----------------
GMAIL_OAUTH_CLIENT=secrets/gmail_oauth_client.json
GMAIL_TOKEN=secrets/gmail_token.json
# 审批相关邮件的收发地址（demo 中 Sponsor / Owner / Steward 可以是同一个人）
MAIL_FROM=
MAIL_SPONSOR=
MAIL_OWNER=
MAIL_STEWARD=
SOURCE_RO_PASSWORD=ro_pass

# ---------------- 数据集 ----------------
# 小数据集（Northwind ~340K / Olist ~45MB）默认放项目内 data/，已 gitignore。
# 大数据集（Home Credit 2.68GB）建议指向项目外，避免撑大 docker build context 与备份。
DATASETS_DIR=./data
# 例：DATASETS_DIR=/Volumes/kong disk 727899339/datasets
